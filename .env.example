# The online booking link. Every "Book" button on the site points here.
# Copy this file to .env and set the real value. If it is unset, the build
# falls back to the live magsoft booking link.
VITE_BOOKING_URL=https://your-booking-link

# The services/menu API. The services page fetches its price list from here
# at build time. If it is unset, the build falls back to the magsoft menu API.
VITE_SERVICES_URL=https://your-services-api/menu

# The public site origin (no trailing slash). Used for absolute URLs in the
# sitemap, robots.txt, Open Graph tags, and structured data. Set this to the
# real domain before a production deploy. If it is unset, it falls back to the
# staging URL.
VITE_SITE_URL=https://shayna.starb.ca
